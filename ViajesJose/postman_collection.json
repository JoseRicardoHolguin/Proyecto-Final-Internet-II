            "url": {
              "raw": "{{base_url}}/api/documents/1",
              "host": ["{{base_url}}"],
              "path": ["api", "documents", "1"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Visa\",\n  \"required\": false\n}"
            }
          },
          "response": []
        },
        {
          "name": "DELETE /api/documents/{id} - Eliminar",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/documents/1",
              "host": ["{{base_url}}"],
              "path": ["api", "documents", "1"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
