          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/places/1",
              "host": ["{{base_url}}"],
              "path": ["api", "places", "1"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Louvre\",\n  \"description\": \"Museo del Louvre\",\n  \"latitude\": 48.8606,\n  \"longitude\": 2.3376\n}"
            }
          },
          "response": []
        },
        {
          "name": "DELETE /api/places/{id} - Eliminar",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/places/1",
              "host": ["{{base_url}}"],
              "path": ["api", "places", "1"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents (Documentación)",
      "item": [
        {
          "name": "GET /api/documents - Listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/documents - Crear",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "documents"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"travel_id\": 1,\n  \"name\": \"Pasaporte\",\n  \"file_path\": \"/documents/passport.pdf\",\n  \"required\": true\n}"
            }
          },
          "response": []
